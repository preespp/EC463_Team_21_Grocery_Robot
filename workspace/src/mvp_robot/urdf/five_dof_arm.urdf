<?xml version="1.0"?>
<robot name="five_dof_arm">

  <!-- === LINKS === -->

  <!-- Base link sitting on the ground -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Vertical column above base -->
  <link name="link1_tower">
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.2"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- Upper arm -->
  <link name="link2_upper_arm">
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.04 0.04"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.04 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- Forearm -->
  <link name="link3_forearm">
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.035 0.035"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.5 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.035 0.035"/>
      </geometry>
    </collision>
  </link>

  <!-- Wrist body (before gripper) -->
  <link name="link4_wrist">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.03 0.03"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.03 0.03"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper base -->
  <link name="gripper_base">
    <inertial>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper finger 1 (actuated by joint5) -->
  <link name="gripper_finger1">
    <inertial>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.01 0.02"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.01 0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper finger 2 (mimic of joint5) -->
  <link name="gripper_finger2">
    <inertial>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.01 0.02"/>
      </geometry>
      <material name="silver2">
        <color rgba="0.8 0.8 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.01 0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- === JOINTS === -->

  <!-- Joint 1: base yaw, 270 deg total, about Z -->
  <joint name="joint1_base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="link1_tower"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- ±135 degrees -->
    <limit lower="-2.3562" upper="2.3562" effort="50.0" velocity="2.0"/>
  </joint>

  <!-- Joint 2: shoulder pitch at top of tower (about Y) -->
  <joint name="joint2_shoulder" type="revolute">
    <parent link="link1_tower"/>
    <child link="link2_upper_arm"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="50.0" velocity="2.0"/>
  </joint>

  <!-- Joint 3: elbow pitch (about Y) -->
  <joint name="joint3_elbow" type="revolute">
    <parent link="link2_upper_arm"/>
    <child link="link3_forearm"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.3562" effort="40.0" velocity="2.0"/>
  </joint>

  <!-- Joint 4: wrist roll (about X or Z – here Z) -->
  <joint name="joint4_wrist_roll" type="revolute">
    <parent link="link3_forearm"/>
    <child link="link4_wrist"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- ±135 degrees -->
    <limit lower="-2.3562" upper="2.3562" effort="30.0" velocity="3.0"/>
  </joint>

  <!-- Fixed joint from wrist to gripper base -->
  <joint name="joint_gripper_mount" type="fixed">
    <parent link="link4_wrist"/>
    <child link="gripper_base"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Joint 5: gripper open/close, actuated (about Y) -->
  <joint name="joint5_gripper" type="revolute">
    <parent link="gripper_base"/>
    <child link="gripper_finger1"/>
    <origin xyz="0.02 0.015 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 0 rad = open, positive = close -->
    <limit lower="0.0" upper="0.8" effort="10.0" velocity="3.0"/>
  </joint>

  <!-- Mimic joint for second finger (moves opposite) -->
  <joint name="joint5_gripper_mimic" type="revolute">
    <parent link="gripper_base"/>
    <child link="gripper_finger2"/>
    <origin xyz="0.02 -0.015 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.0" effort="10.0" velocity="3.0"/>
    <mimic joint="joint5_gripper" multiplier="-1.0" offset="0.0"/>
  </joint>
  
  <!-- Joint 1: base yaw -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint1_base_yaw</joint_name>
      <topic>/arm/joint1_cmd</topic>
      <p_gain>10.0</p_gain>
    </plugin>
  </gazebo>

  <!-- Joint 2: shoulder -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint2_shoulder</joint_name>
      <topic>/arm/joint2_cmd</topic>
      <p_gain>10.0</p_gain>
    </plugin>
  </gazebo>

  <!-- Joint 3: elbow -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint3_elbow</joint_name>
      <topic>/arm/joint3_cmd</topic>
      <p_gain>10.0</p_gain>
    </plugin>
  </gazebo>

  <!-- Joint 4: wrist roll -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint4_wrist_roll</joint_name>
      <topic>/arm/joint4_cmd</topic>
      <p_gain>5.0</p_gain>
    </plugin>
  </gazebo>

  <!-- Joint 5: gripper -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint5_gripper</joint_name>
      <topic>/arm/joint5_cmd</topic>
      <p_gain>3.0</p_gain>
    </plugin>
  </gazebo>


</robot>

